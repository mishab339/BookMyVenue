# Application
# Execution environment: development | test | production
NODE_ENV=development
# TCP port the HTTP server listens on
PORT=3000

# Database (MySQL 8.0+)
DB_HOST=localhost
# MySQL port (default: 3306)
DB_PORT=3306
# Name of the MySQL database / schema
DB_NAME=book_my_venue
# MySQL user with read/write access to DB_NAME
DB_USER=root
# Password for DB_USER — never commit real credentials here
DB_PASSWORD=secret

# JWT
# Secret used to sign access tokens — must be at least 32 characters
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
# Secret used to sign refresh tokens — must be at least 32 characters (different from access secret)
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
# Expiry for access tokens (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Expiry for refresh tokens (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt
# Number of hashing rounds — higher is more secure but slower (recommended: 10-14)
BCRYPT_ROUNDS=12

# Pagination
# Default number of items returned per page for list endpoints
DEFAULT_PAGE_SIZE=20
